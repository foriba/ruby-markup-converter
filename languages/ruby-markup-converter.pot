#: includes/constants.php:122
msgid "Apply Only Within Shortcodes"
msgstr ""

#: includes/constants.php:123
msgid "Converts markup only within [rubymarkup]...[/rubymarkup] blocks. This helps prevent unintended conversions and reduces processing overhead."
msgstr ""

#: includes/constants.php:130
msgid "Apply to Entire Post Content"
msgstr ""

#: includes/constants.php:131
msgid "Automatically converts markup throughout the post content without requiring shortcodes. This is more convenient, but unintended text may also be converted."
msgstr ""


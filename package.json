{
    "name": "ruby-markup-converter",
    "version": "1.2.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "wp-scripts start --source-path=editor/src --output-path=editor/build --blocks-manifest",
        "build": "npm run build:blocks && npm run build:admin && npm run build:post-settings",
        "build:post-settings": "wp-scripts build --source-path=editor/settings/src --output-path=editor/settings/build",
        "start:post-settings": "wp-scripts start --source-path=editor/settings/src --output-path=editor/settings/build",
        "build:blocks": "wp-scripts build --source-path=editor/src --output-path=editor/build --blocks-manifest",
        "build:admin": "wp-scripts build --source-path=admin/src --output-path=admin/build",
        "start:admin": "wp-scripts start --source-path=admin/src --output-path=admin/build",
        "format": "wp-scripts format editor/src editor/settings/src admin/src",
        "lint:js": "wp-scripts lint-js editor/src editor/settings/src admin/src --ext .js,.jsx,.ts,.tsx"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/foriba/ruby-markup-converter.git"
    },
    "keywords": [],
    "author": "",
    "license": "GPL-2.0-or-later",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/foriba/ruby-markup-converter/issues"
    },
    "homepage": "https://github.com/foriba/ruby-markup-converter#readme",
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@wordpress/api-fetch": "^7.57.0",
        "@wordpress/block-editor": "^16.2.0",
        "@wordpress/blocks": "^15.27.0",
        "@wordpress/components": "39.0.0",
        "@wordpress/dom-ready": "^4.56.0",
        "@wordpress/element": "8.5.0",
        "@wordpress/i18n": "^6.27.0",
        "@wordpress/rich-text": "^7.53.0",
        "@wordpress/scripts": "^34.1.0"
    },
    "dependencies": {
        "@wordpress/admin-ui": "^2.11.0",
        "@wordpress/ui": "^0.23.0"
    }
}

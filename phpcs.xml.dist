<?xml version="1.0"?>
<ruleset name="Ruby Markup Converter">

    <description>
        PHPCS configuration for Ruby Markup Converter.
    </description>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress-Core" />
    <rule ref="WordPress-Docs" />
    <rule ref="WordPress-Extra" />

    <!-- Scan PHP source files -->
    <file>admin</file>
    <file>includes</file>
    <file>ruby-markup-converter.php</file>
    <file>uninstall.php</file>

    <!-- Exclude -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/editor/build/*</exclude-pattern>

    <!-- Encoding -->
    <arg name="encoding" value="utf-8"/>
    <arg name="extensions" value="php"/>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Colors -->
    <arg name="colors"/>

</ruleset>
